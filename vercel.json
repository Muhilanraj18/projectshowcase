{
  "version": 2,
  "builds": [
    { "src": "api/register.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/register", "dest": "/api/register.js" },
    { "src": "/registration", "dest": "/reg.html" },
    { "src": "/admin", "dest": "/admin.html" },
    { "src": "/", "dest": "/shadastria-adepti.html" }
  ]
}
